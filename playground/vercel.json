{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/agents/quickstart.md",
      "destination": "/agents/quickstart.md"
    },
    {
      "source": "/colab_robotics_worker.ipynb",
      "destination": "/colab_robotics_worker.ipynb"
    },
    {
      "source": "/v1/models",
      "destination": "/v1/models.json"
    },
    {
      "source": "/v1/telemetry",
      "destination": "/v1/telemetry.json"
    },
    {
      "source": "/v1/workers",
      "destination": "/v1/workers.json"
    },
    {
      "source": "/v1/robotics/catalog",
      "destination": "/v1/robotics/catalog.json"
    }
  ]
}
